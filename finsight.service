[Unit]
Description=FinSight backend API
After=network.target

[Service]
User=finsight
WorkingDirectory=/opt/finsight/backend
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
StandardOutput=append:/var/log/finsight/app.log
StandardError=append:/var/log/finsight/app.log

[Install]
WantedBy=multi-user.target
